server {
    server_name ${MY_DNS} www.${MY_DNS};

    location / {
        return 301 https://$host:${NGINX_PORT}$request_uri;
    }
}

server {
    listen ${NGINX_PORT} ssl;
    server_name ${MY_DNS};

    ssl_certificate /etc/letsencrypt/live/${MY_DNS}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MY_DNS}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location /static/ {
        alias /usr/share/nginx/html/static/;
    }

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port ${NGINX_PORT};

        proxy_pass http://web:${WEB_PORT};
        proxy_redirect off;
    }
}